{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "left": 1,
        },
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "blue",
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "┌───────────────────    Framework  ────────────────────┐",
            "color": "#ffffff",
        },
        {
            "type": "cpu",
            "key": "  ├ ",
            "format": "{0}",
            "showPeCoreCount": true,
        },
        {
            "key": "  ├󰣇 ",
            "type": "kernel",
        },
        {
            "key": " ",
            "type": "battery",
            "format": "lua:local args = ...; local c = args.capacity; return '  ├' .. (c < 10 and '󰂃' or (c < 20 and '󰁺' or (c < 30 and '󰁻' or (c < 40 and '󰁼' or (c < 50 and '󰁽' or (c < 60 and '󰁾' or (c < 70 and '󰁿' or (c < 80 and '󰂀' or (c < 90 and '󰂁' or (c < 100 and '󰂂' or '󰁹')))))))))) .. '  ' .. c .. '%'"
        },
        {
            "type": "packages",
            "key": "  ├󰏖 ",
        },
        {
            "type": "shell",
            "key": "  ├ ",
        },
        {
            "type": "command",
            "key": "  ├ ",
            "text": "downtime",
        },
        {
            "type": "custom",
            "key": "└───────────────────────────────────────────────────────┘",
        },
    ],
}
