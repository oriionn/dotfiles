{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "left": 1,
        },
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "blue",
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "┌───────────────────    Framework  ────────────────────┐",
            "color": "#ffffff",
        },
        {
            "type": "cpu",
            "key": "  ├ ",
            "format": "{0}",
            "showPeCoreCount": true,
        },
        {
            "key": "  ├󰣇 ",
            "type": "kernel",
        },
        {
            "key": " ",
            "type": "battery",
            "format": "qjs:`  ├${this.capacity < 10 ? '󰂃':(this.capacity < 20 ? '󰁺':(this.capacity < 30 ? '󰁻':(this.capacity < 40 ? '󰁼':(this.capacity < 50 ? '󰁽':(this.capacity < 60 ? '󰁾':(this.capacity < 70 ? '󰁿':(this.capacity < 80 ? '󰂀':(this.capacity < 90 ? '󰂁':(this.capacity < 100 ? '󰂂':'󰁹')))))))))}  ${this.capacity}%`"
        },
        {
            "type": "packages",
            "key": "  ├󰏖 ",
        },
        {
            "type": "shell",
            "key": "  ├ ",
        },
        {
            "type": "command",
            "key": "  ├ ",
            "text": "downtime",
        },
        {
            "type": "custom",
            "key": "└───────────────────────────────────────────────────────┘",
        },
    ],
}
