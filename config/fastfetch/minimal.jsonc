{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "left": 1,
            "top": 2
        },
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "blue",
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "┌───────────────────    Framework  ────────────────────┐",
            "color": "#ffffff",
        },
        {
            "type": "cpu",
            "key": "  ├ ",
            "format": "{0}",
            "showPeCoreCount": true,
        },
        {
            "key": "  ├󰣇 ",
            "type": "kernel",
        },
        {
            "key": "  ├󰁹 ",
            "type": "battery",
            "format": "{capacity}",
            "percent": {"type":["num"]}
        },
        {
            "type": "packages",
            "key": "  ├󰏖 ",
        },
        {
            "type": "shell",
            "key": "  ├ ",
        },
        {
            "type": "command",
            "key": "  ├ ",
            "text": "downtime",
        },
        {
            "type": "custom",
            "key": "└───────────────────────────────────────────────────────┘",
        },
    ],
}
